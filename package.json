{
  "name": "education-lyceum-board",
  "private": true,
  "description": "The Lyceum: a searchable community inquiry archive for the Praxium Learning Foundation",
  "scripts": {
    "build:css": "tailwindcss -i styles/tailwind-input.css -o board.css --minify",
    "watch:css": "tailwindcss -i styles/tailwind-input.css -o board.css --watch",
    "test:e2e": "playwright test --project=chromium-desktop --project=mobile-360",
    "test:e2e:demo": "playwright test --project=demo"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "tailwindcss": "3.4.17"
  }
}
